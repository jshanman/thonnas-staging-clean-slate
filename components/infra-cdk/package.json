{
  "name": "@thonnas/infra-cdk",
  "version": "0.3.0-beta.41",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm install && tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint --ext .ts src",
    "test": "jest",
    "test:watch": "jest --watch",
    "infra:plan": "npm run build && node dist/bin/infra-provider.js plan",
    "infra:apply": "npm run build && node dist/bin/infra-provider.js apply",
    "infra:destroy": "npm run build && node dist/bin/infra-provider.js destroy",
    "infra:identity-assume": "npm run build && node dist/bin/infra-provider.js identity-assume",
    "infra:release": "npm run build && node dist/bin/infra-provider.js release",
    "infra:rollback": "npm run build && node dist/bin/infra-provider.js rollback",
    "infra:history": "npm run build && node dist/bin/infra-provider.js history",
    "infra:docker-build": "docker build -t thonnas/infra-cdk -f docker/Dockerfile.awscli .",
    "infra:docker-shell": "node scripts/infra-docker.js shell",
    "infra:aws-config": "node scripts/infra-docker.js aws-config",
    "infra:aws-config-list": "node scripts/infra-docker.js aws-config-list",
    "localstack:start": "node scripts/localstack.js start",
    "localstack:stop": "node scripts/localstack.js stop",
    "localstack:logs": "node scripts/localstack.js logs",
    "generate:endpoints": "npm install && tsx scripts/generate-endpoints.ts",
    "fetch:ec2-invocation": "tsx scripts/fetch-ec2-invocation.ts"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.940.0",
    "@aws-sdk/client-cloudformation": "^3.940.0",
    "@aws-sdk/client-cloudfront": "^3.940.0",
    "@aws-sdk/client-ec2": "^3.940.0",
    "@aws-sdk/client-ecs": "^3.1121.0",
    "@aws-sdk/client-iam": "^3.940.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1121.0",
    "@aws-sdk/client-lambda": "^3.1127.0",
    "@aws-sdk/client-route-53": "^3.634.0",
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/client-secrets-manager": "^3.940.0",
    "@aws-sdk/client-ssm": "^3.940.0",
    "@aws-sdk/client-sts": "^3.940.0",
    "@aws-sdk/credential-provider-node": "^3.940.0",
    "@aws-sdk/shared-ini-file-loader": "^3.374.0",
    "aws-cdk-lib": "^2.149.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "constructs": "^10.3.0",
    "esbuild": "^0.25.12",
    "handlebars": "^4.7.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "aws-cdk": "^2.149.1",
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.2"
  }
}



