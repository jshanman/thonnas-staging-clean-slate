# Copy to .env.<env> (e.g. .env.beta) or set in shell before infra:plan / infra:apply.
# Values are read at deploy time and baked into EC2 user-data for compose-host.
# Run `thonnas config resolve` to generate .env.<env> from thonnas-config (with defaults).

# User-provided: your git repo and clone credentials
# THONNAS_COMPOSE_GIT_REPO_URL=https://github.com/your-org/your-repo.git
# THONNAS_COMPOSE_GIT_USERNAME=git

# User-provided: root domain for hostnames (also prompted by thonnas config setup).
# If unset, infra-cdk falls back to example.local so plan still works before a real domain is chosen.
# THONNAS_ROOT_DOMAIN=example.local

# Optional overrides (defaults in thonnas-config or strategy extras)
# THONNAS_COMPOSE_GIT_BRANCH=main
# THONNAS_COMPOSE_GIT_PASSWORD_SECRET_NAME=GIT_CLONE_PASSWORD

