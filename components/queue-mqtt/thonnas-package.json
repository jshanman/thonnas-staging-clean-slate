    "classification": "open-source",
    "framework": "emqx",
    "language": "config",
    "implements_strategies": [
      "client-message-push",
      "client-message-two-way",
      "comms.queue.pub-sub.mqtt",
      "comms.events.pub-sub",
      "comms.duplex.bidirectional"
    ],
    "compatible_modules": []
  }
}

