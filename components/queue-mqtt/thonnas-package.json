{
  "name": "@thonnas/queue-mqtt",
  "version": "0.2.0-beta.10",
  "description": "MQTT broker for pub/sub messaging and real-time communication (Eclipse Mosquitto via compose-host in beta; EMQX static-discovery fleet cluster in staging/production).",
  "dependencies": {
    "@thonnas/infra-docker": "latest"
  },
  "thonnas": {
    "package_type": "component",
