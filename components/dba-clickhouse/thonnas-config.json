      "selfImportPath": "connection.fleet.host"
    },
    {
      "name": "THONNAS_DBA_FLEET_PORT",
      "description": "Portable fleet native port for peers.",
      "default": 9000,
      "selfImportPath": "connection.fleet.port"
    },
    {
      "name": "THONNAS_DBA_FLEET_USER",
