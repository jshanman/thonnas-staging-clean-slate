      "selfImportPath": "connection.internal.native.host",
      "provider": "infra"
    },
    {
      "name": "DBA_CLICKHOUSE_NATIVE_PORT",
      "description": "Internal ClickHouse native port.",
      "default": 9000,
      "selfImportPath": "connection.internal.native.port",
      "provider": "infra"
    },
    {
      "name": "DBA_CLICKHOUSE_HTTP_PORT",
