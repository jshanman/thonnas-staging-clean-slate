# Local Compose defaults for testing reverse proxy + web-angular in beta mode.
# Copy this file to `.env.local` (gitignored) before running the commands below.

THONNAS_ENV=beta
WEB_ANGULAR_HOST_PORT=4200
WEB_ANGULAR_CONTAINER_PORT=4200

# Host port overrides (optional). All compose host ports use ${VAR:-default}; override here to avoid conflicts.
# e2e-build validates that default host ports do not collide; set these when using non-default ports.
# REVERSE_PROXY_HOST_PORT=80
# API_NEST_APP_PORT=3000
# API_NEST_DEBUG_PORT=9229
# API_NEST_THONNAS_MARKETPLACE_APP_PORT=3051
# API_NEST_THONNAS_MARKETPLACE_DEBUG_PORT=9230
# API_GO_APP_PORT=3001
# API_GO_METRICS_PORT=9090
# CACHE_REDIS_HOST_PORT=6379
# QUEUE_MQTT_HOST_PORT=1883
# QUEUE_MQTT_WS_HOST_PORT=9001
# DBT_POSTGRES_HOST_PORT=5432
# DASHBOARD_TEMPORAL_HOST_PORT=8088
# API_GROWTHBOOK_SDK_HOST_PORT=3101
# API_GROWTHBOOK_DASHBOARD_HOST_PORT=3102
# DEPENDENCY_MANAGER_VERDACCIO_HOST_PORT=4873
# METRICS_OTEL_SIGNOZ_HOST_PORT=8080
# METRICS_OTEL_SIGNOZ_OTEL_GRPC_HOST_PORT=4317
# METRICS_OTEL_SIGNOZ_OTEL_HTTP_HOST_PORT=4318

# Hostnames for the reverse proxy (server_name in nginx). All routes are derived from each component's
# thonnas-infra.json (derivations + endpoints.internal); nothing is hardcoded in infra-docker.
# With API_NEST_EXTERNAL_HOST=api.localhost and api-nest running: api.localhost:80 -> api-nest:3000.
# Add 127.0.0.1 api.localhost (and similar) to your hosts file so *.localhost resolves.
API_NEST_EXTERNAL_HOST=api.localhost
API_NEST_HOST=api.localhost
WEB_ANGULAR_HOST=web.localhost
DASHBOARD_GROWTHBOOK_HOST=growthbook.localhost
API_GROWTHBOOK_HOST=gb-api.localhost
DASHBOARD_TEMPORAL_HOST=temporal.localhost
METRICS_OTEL_SIGNOZ_HOST=signoz.localhost
QUEUE_MQTT_EXTERNAL_HOST=mqtt.localhost


